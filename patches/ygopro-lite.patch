+    }
+    ygo::LiteTrace("startup ok: YGOPro Lite 1.036.2; audio=excluded playback=excluded network=loopback-only");
+    game.MainLoop();
+    ygo::LiteTrace("shutdown clean");
+    WSACleanup();
+    return EXIT_SUCCESS;
