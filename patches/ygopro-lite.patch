+// Local recorder for the pinned YGOPro core. No rule decisions are inferred from text.
+#include "training_support.h"
+#include "game.h"
+#include "single_mode.h"
+#include "duelclient.h"
+#include "data_manager.h"
+#include "client_card.h"
